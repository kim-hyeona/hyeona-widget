<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/container" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="18dp" android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌊  TODAY" android:textSize="11sp" android:textColor="#6B8C91" android:letterSpacing="0.12" />
    <TextView android:id="@+id/date" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:layout_marginBottom="10dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#28373B" />
    <LinearLayout android:id="@+id/row1" style="@style/TaskRow"><Button android:id="@+id/check1" style="@style/Check"/><TextView android:id="@+id/text1" style="@style/TaskText"/></LinearLayout>
    <LinearLayout android:id="@+id/row2" style="@style/TaskRow"><Button android:id="@+id/check2" style="@style/Check"/><TextView android:id="@+id/text2" style="@style/TaskText"/></LinearLayout>
    <LinearLayout android:id="@+id/row3" style="@style/TaskRow"><Button android:id="@+id/check3" style="@style/Check"/><TextView android:id="@+id/text3" style="@style/TaskText"/></LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="12sp" android:textColor="#76888B" />
</LinearLayout>

