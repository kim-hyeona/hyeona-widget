<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WAVE  ·  TODAY"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#52777D" />

    <TextView
        android:id="@+id/date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="8dp"
        android:text="오늘"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="#20363B" />

    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/check1" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="○" android:textSize="22sp" android:textColor="#338E91" />
        <TextView android:id="@+id/text1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="할 일" android:textSize="14sp" android:textColor="#263E43" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/check2" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="○" android:textSize="22sp" android:textColor="#338E91" />
        <TextView android:id="@+id/text2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="할 일" android:textSize="14sp" android:textColor="#263E43" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="38dp" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/check3" android:layout_width="38dp" android:layout_height="38dp" android:gravity="center" android:text="○" android:textSize="22sp" android:textColor="#338E91" />
        <TextView android:id="@+id/text3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:text="할 일" android:textSize="14sp" android:textColor="#263E43" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="오늘 할 일이 없어요 ♡"
        android:textSize="13sp"
        android:textColor="#637B80" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="6dp"
        android:background="#3352777D" />

    <TextView
        android:id="@+id/money_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="이번 달 가계부"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#20363B" />
</LinearLayout>
